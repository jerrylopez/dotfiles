#!/usr/bin/env bash
# Runs when herdr creates a worktree. Hands it to `warden worktree`, which
# configures a Warden environment for it, or does nothing if the project is not
# a Warden one.

set -uo pipefail

log() { >&2 echo "[warden-env] $*"; }

# The herdr server is daemonised with the default system PATH — no
# /opt/warden/bin, no Homebrew — and inherits nothing from the shell, so
# warden is not on it. herdr has no setting for a plugin's environment, so the
# path is rebuilt here instead. Each candidate is the directory a warden
# install puts its binary in on one of the machines this runs on.
for dir in /opt/warden/bin /usr/local/bin /opt/homebrew/bin "${HOME}/.warden/bin"; do
  [[ -d "${dir}" ]] && PATH="${dir}:${PATH}"
done
export PATH

if ! command -v warden >/dev/null 2>&1; then
  log "warden is not on the path; nothing to do"
  exit 0
fi

# The payload holds one checkout_path, so the first match is the only match and
# bash's own expansion is enough to read it. Guarded because trimming a prefix
# that is not there would return the whole document.
EVENT="${HERDR_PLUGIN_EVENT_JSON:-}"

if [[ "${EVENT}" != *'"checkout_path":"'* ]]; then
  log "no checkout path in the event payload; nothing to do"
  exit 0
fi

CHECKOUT="${EVENT#*\"checkout_path\":\"}"
CHECKOUT="${CHECKOUT%%\"*}"

if [[ -z "${CHECKOUT}" || ! -d "${CHECKOUT}" ]]; then
  log "checkout '${CHECKOUT}' does not exist; nothing to do"
  exit 0
fi

log "configuring ${CHECKOUT}"
warden worktree "${CHECKOUT}" >/dev/null || log "warden worktree exited ${?}"
