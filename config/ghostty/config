title = "  "

# Colors, taken from the Hotkey Window profile in config/iterm/preferences, so a
# Ghostty window and an iTerm one look the same. Set out in full rather than as a
# theme, because no Ghostty theme carries them.
background = #1d1f28
foreground = #fdfdfd
cursor-color = #c574dd
cursor-text = #ffffff
selection-background = #c1deff
selection-foreground = #000000

# iTerm has Use Bright Bold on, with this as the bold color.
bold-color = #ffffff

palette = 0=#282a36
palette = 1=#f37f97
palette = 2=#5adecd
palette = 3=#f2a272
palette = 4=#8897f4
palette = 5=#c574dd
palette = 6=#79e6f3
palette = 7=#fdfdfd
palette = 8=#414458
palette = 9=#ff4971
palette = 10=#18e3c8
palette = 11=#ff8037
palette = 12=#556fff
palette = 13=#b043d1
palette = 14=#3fdcee
palette = 15=#bebec1

font-family = FiraCode
font-style = Medium
font-style-italic = Medium Italic
font-style-bold = Medium
font-style-bold-italic = Medium Italic
window-padding-balance = true

window-save-state = always

# Left on, though starting without a window would suit a quick-terminal-only
# setup, because false makes Ghostty ignore quick-terminal-size and open the
# quick terminal at a fraction of the size asked for — which a TUI cannot
# survive. Broken since the option shipped in 1.2.0, still open upstream:
# https://github.com/ghostty-org/ghostty/issues/10658
initial-window = true

cursor-style = underline
cursor-style-blink = false
adjust-cursor-thickness = 2
confirm-close-surface = false
shell-integration-features = sudo,no-cursor
keybind = shift+enter=text:\x1b\r

# Custom
split-divider-color = #2C313A

macos-titlebar-proxy-icon = hidden
font-size = 16
window-padding-y = 8,0
window-padding-x = 8,8
macos-option-as-alt = true
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+l=goto_split:right

# Quick terminal, standing in for the iTerm hotkey window. 100% is the primary
# axis — height, for a terminal positioned at the top — and the secondary axis is
# maximized on its own, so this covers the screen.
quick-terminal-position = top
quick-terminal-size = 100%

# Shorter than the 0.2 default. The slide is there to show where the terminal
# came from, not to be watched.
quick-terminal-animation-duration = 0.15

# A chord rather than the double-tapped modifier iTerm uses, which Ghostty has no
# equivalent for. ⌥space is free here: Raycast holds ⌘space, and both input-source
# shortcuts that want space are disabled.
keybind = global:opt+space=toggle_quick_terminal
