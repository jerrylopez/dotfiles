# Linux, headless.
#
# No casks: there is no GUI on this box. No dnsmasq either -- that is Mac-only,
# for pointing *.test at the VPS. And no coreutils, which the Mac needs to get
# GNU tools but Linux already ships as its system default.

tap 'jondot/tap'

brew 'ack'
brew 'gcc'
brew 'git'
brew 'grc'
brew 'gh'
# imagemagick and jp2a are here for spaceman-diff, which renders image diffs
# as ASCII; they travel together or not at all.
brew 'imagemagick'
brew 'jp2a'
brew 'jq'
brew 'libgit2'
brew 'openssl'
# $EDITOR on this box, from brew because Ubuntu does not package a current
# Neovim. The rest is what LazyVim leans on: ripgrep and fd back its pickers,
# and lazygit is what <leader>gg opens.
brew 'neovim'
brew 'ripgrep'
brew 'fd'
brew 'lazygit'
brew 'php'
brew 'composer'
brew 'node'
brew 'nodenv'
brew 'readline'
brew 'pv'
brew 'roundup'
brew 'spaceman-diff'
brew 'wget'
brew 'zsh'
brew 'zsh-completions'
