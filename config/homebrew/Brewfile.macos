cask_args appdir: '/Applications'

tap 'jondot/tap'
tap 'homebrew/bundle'

brew 'ack'
brew 'coreutils'
brew 'dnsmasq'
brew 'gcc'
brew 'git'
brew 'grc'
brew 'gh'
brew 'imagemagick'
brew 'jp2a'
brew 'jq'
brew 'libgit2'
# Neovim, plus what LazyVim leans on: ripgrep and fd back its pickers, and
# lazygit is what <leader>gg opens.
brew 'neovim'
brew 'ripgrep'
brew 'fd'
brew 'lazygit'
brew 'openssl'
# PHP came from Homebrew rather than Herd even while Herd was installed, so
# uninstalling it changed nothing here except that this is now the only source.
brew 'php'
brew 'composer'
brew 'node'
brew 'nodenv'
brew 'readline'
brew 'pv'
brew 'roundup'
brew 'spaceman-diff'
brew 'wget'
brew 'youtube-dl'
brew 'zsh'
brew 'zsh-completions'

cask '1password'
cask 'fantastical'
cask 'font-fira-code'
cask 'github'
cask 'google-chrome'
cask 'keepingyouawake'
cask 'slack'
cask 'tableplus'
cask 'visual-studio-code'
cask 'figma'
cask 'phpstorm'
cask 'postman'
