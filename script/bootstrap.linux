#!/usr/bin/env bash
#
# The Linux half of the bootstrap. Ubuntu/Debian, headless.
#
# There is deliberately no counterpart to script/defaults: nothing with a GUI
# to configure.

set -e

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

HOMEBREW_PREFIX="/home/linuxbrew/.linuxbrew"

if ! command -v brew >/dev/null 2>&1 && [ ! -x "${HOMEBREW_PREFIX}/bin/brew" ]; then
    # Homebrew on Linux builds far more from source than it does on macOS, so
    # it will not install at all without a compiler and these basics present.
    sudo apt-get update
    sudo apt-get install -y build-essential curl file git procps

    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Either the installer just ran and left PATH untouched, or brew was already
# there from a previous run but this non-login shell never sourced shellenv.
if ! command -v brew >/dev/null 2>&1; then
    eval "$("${HOMEBREW_PREFIX}/bin/brew" shellenv)"
fi

brew bundle --file="${BASEDIR}/config/homebrew/Brewfile.linux"

# |----------------------------------------------------------------
# | Make zsh the login shell
# |----------------------------------------------------------------

# Ubuntu logs you into bash, and nothing in this repo is read until that
# changes -- ~/.zshrc is only sourced by zsh.
ZSH_BIN="$(brew --prefix)/bin/zsh"

# chsh refuses any shell missing from /etc/shells, and Homebrew's is never
# listed there by default.
if ! grep -qxF "${ZSH_BIN}" /etc/shells 2>/dev/null; then
    echo "${ZSH_BIN}" | sudo tee -a /etc/shells >/dev/null
fi

# The login shell is the one recorded in passwd. $SHELL is inherited from
# whatever invoked this script and would answer the wrong question.
USER_NAME="$(id -un)"
LOGIN_SHELL="$(getent passwd "${USER_NAME}" | cut -d: -f7)"

if [ "${LOGIN_SHELL}" != "${ZSH_BIN}" ]; then
    # This leaves the login shell pointing inside /home/linuxbrew. Removing
    # Homebrew would then lock this account out of ssh, so set the shell back
    # to /bin/bash before ever doing that.
    sudo chsh -s "${ZSH_BIN}" "${USER_NAME}"

    echo "Login shell set to ${ZSH_BIN}. It takes effect on the next login."
fi
