#!/usr/bin/env bash
#
# Wildcard *.test DNS -> the Warden VPS, over Tailscale.
#
# Warden's traefik on the VPS routes by hostname, so this Mac needs every
# *.test name to resolve to the VPS's Tailscale IP. macOS has no wildcard
# support in /etc/hosts, so we run a local dnsmasq and point /etc/resolver/test
# at it -- that scopes the override to *.test only, leaving all other DNS alone.
#
# The VPS IP is looked up fresh from Tailscale on every run and never
# hardcoded, so a rebuilt VPS only needs a re-run of this script.
#
# Every step is idempotent; re-running is the supported way to refresh the IP.

set -euo pipefail

# The Tailscale machine name of the VPS running Warden. `tailscale status`
# lists it. Change this if the VPS is replaced under a different name.
VPS_MACHINE_NAME="vps-c4ad6f1e"

BREW_PREFIX="$(brew --prefix)"
DNSMASQ_CONF="${BREW_PREFIX}/etc/dnsmasq.conf"
DNSMASQ_CONF_DIR="${BREW_PREFIX}/etc/dnsmasq.d"
DROP_IN="${DNSMASQ_CONF_DIR}/warden-test.conf"
RESOLVER_FILE="/etc/resolver/test"

info() { printf '\033[0;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[0;33m==>\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[0;31m==>\033[0m %s\n' "$*" >&2; exit 1; }

# |----------------------------------------------------------------
# | Resolve the VPS's Tailscale IP
# |----------------------------------------------------------------

tailscale_bin() {
    if command -v tailscale >/dev/null 2>&1; then
        command -v tailscale
    elif [ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]; then
        echo /Applications/Tailscale.app/Contents/MacOS/Tailscale
    else
        die "tailscale not found. Install it and sign in, then re-run."
    fi
}

TAILSCALE="$(tailscale_bin)"

VPS_IP="$("${TAILSCALE}" ip -4 "${VPS_MACHINE_NAME}" 2>/dev/null | head -1 || true)"

case "${VPS_IP}" in
    100.*) ;;
    *) die "Could not resolve a Tailscale IP for '${VPS_MACHINE_NAME}'. Is Tailscale up, and is that the right machine name? (see: ${TAILSCALE} status)" ;;
esac

info "${VPS_MACHINE_NAME} is ${VPS_IP}"

# |----------------------------------------------------------------
# | Install dnsmasq
# |----------------------------------------------------------------

if brew list --formula dnsmasq >/dev/null 2>&1; then
    info "dnsmasq already installed"
else
    info "Installing dnsmasq"
    brew install dnsmasq
fi

# |----------------------------------------------------------------
# | Make sure nothing else owns port 53
# |----------------------------------------------------------------

# Warden runs its own dnsmasq container locally, which also wants :53 and
# answers *.test with 127.0.0.1 -- wrong for us, since the sites live on the
# VPS. If it's up, take it down.
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    if docker ps --format '{{.Names}}' | grep -q 'dnsmasq'; then
        warn "A local Warden dnsmasq container is running and would fight for port 53."
        warn "Stopping Warden's local services: warden svc down"
        warden svc down
        warn "Warden's local services are now DOWN. Bring them back with 'warden svc up' if you need them."
    fi
fi

info "Checking what's listening on port 53"
sudo -v
PORT_53_HOLDERS="$(
    sudo lsof -nP -iUDP:53 -iTCP:53 2>/dev/null \
        | awk 'NR > 1 { print $1 }' \
        | grep -v '^dnsmasq$' \
        | sort -u || true
)"

if [ -n "${PORT_53_HOLDERS}" ]; then
    warn "Something other than dnsmasq is listening on port 53:"
    sudo lsof -nP -iUDP:53 -iTCP:53 >&2 || true
    die "Stop it and re-run, or *.test lookups will go to the wrong resolver."
fi

# |----------------------------------------------------------------
# | Write the dnsmasq drop-in
# |----------------------------------------------------------------

# A drop-in rather than an edit to dnsmasq.conf, so regenerating it each run is
# a plain overwrite with no risk of duplicating lines in the main config.
mkdir -p "${DNSMASQ_CONF_DIR}"

info "Writing ${DROP_IN}"
cat > "${DROP_IN}" <<EOF
# Generated by dotfiles script/dns -- do not edit, it is overwritten each run.
# Wildcard *.test -> Warden VPS (${VPS_MACHINE_NAME}) over Tailscale.
listen-address=127.0.0.1
bind-interfaces
address=/.test/${VPS_IP}
EOF

# The drop-in only takes effect if the main config reads the directory.
if [ ! -f "${DNSMASQ_CONF}" ]; then
    : > "${DNSMASQ_CONF}"
fi

# Homebrew's dnsmasq.conf ships three *commented* conf-dir variants, so we
# append our own line rather than trying to uncomment one -- no pattern can
# un-comment exactly one of them without also matching its neighbours.
if grep -qE "^[[:space:]]*conf-dir=${DNSMASQ_CONF_DIR}" "${DNSMASQ_CONF}"; then
    info "conf-dir already enabled in ${DNSMASQ_CONF}"
else
    info "Adding conf-dir to ${DNSMASQ_CONF}"
    printf '\nconf-dir=%s,*.conf\n' "${DNSMASQ_CONF_DIR}" >> "${DNSMASQ_CONF}"
fi

# Sanity-check the config before handing it to launchd, so a bad edit fails
# here rather than as a service that silently won't stay up.
"${BREW_PREFIX}/opt/dnsmasq/sbin/dnsmasq" --test \
    -C "${DNSMASQ_CONF}" -7 "${DNSMASQ_CONF_DIR},*.conf"

# |----------------------------------------------------------------
# | Run dnsmasq as a root service (port 53 is privileged)
# |----------------------------------------------------------------

info "Restarting dnsmasq"
sudo brew services restart dnsmasq

# |----------------------------------------------------------------
# | Route *.test lookups to it
# |----------------------------------------------------------------

info "Writing ${RESOLVER_FILE}"
sudo mkdir -p "$(dirname "${RESOLVER_FILE}")"
printf 'nameserver 127.0.0.1\n' | sudo tee "${RESOLVER_FILE}" >/dev/null

sudo dscacheutil -flushcache
sudo killall -HUP mDNSResponder

# |----------------------------------------------------------------
# | Verify
# |----------------------------------------------------------------

# dig talks to dnsmasq directly; ping goes through macOS's resolver stack, so
# together they prove both halves of the setup.
info "Verifying dnsmasq answers *.test"
DIG_RESULT="$(dig @127.0.0.1 foo.test +short | head -1)"
if [ "${DIG_RESULT}" != "${VPS_IP}" ]; then
    die "dig @127.0.0.1 foo.test returned '${DIG_RESULT}', expected '${VPS_IP}'"
fi
info "  dig @127.0.0.1 foo.test +short -> ${DIG_RESULT}"

info "Verifying macOS routes *.test to dnsmasq"
PING_RESULT="$(ping -c1 -t2 anything.test 2>&1 | sed -n '1s/.*(\([0-9.]*\)).*/\1/p')"
if [ "${PING_RESULT}" != "${VPS_IP}" ]; then
    die "ping anything.test resolved to '${PING_RESULT}', expected '${VPS_IP}'. Is ${RESOLVER_FILE} in place?"
fi
info "  ping anything.test -> ${PING_RESULT}"

info "Done. *.test now resolves to ${VPS_MACHINE_NAME} (${VPS_IP})."
